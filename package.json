    "@fastify/rate-limit": "^10.1.1",
    "@fastify/websocket": "^11.0.1",
    "fastify": "^5.1.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8",
    "fastify-plugin": "^5.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/ws": "^8.5.13",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^4.1.11",
    "@eslint/js": "^9.14.0"
  }
}
