{
  "name": "bagged-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Multi-chain memecoin PnL/portfolio API \u2014 Solana, BNB Chain, Robinhood Chain, Ethereum.",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
