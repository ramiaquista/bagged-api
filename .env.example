# Server
PORT=8080
LOG_LEVEL=info

# Auth (stubbed for now — see src/plugins/apiKey.ts)
API_KEY_SECRET=dev-secret-change-me
# Local dev only -- accepts the literal "dev" as a valid x-api-key so you
# don't need a real secret to hit the API locally. NEVER set this to
# "true" in Railway/production.
ALLOW_DEV_KEY=true

# CORS (see src/lib/cors.ts). https://bagged.life, https://www.bagged.life,
# and Vercel preview URLs matching https://bagged-website-*.vercel.app are
# always allowed. Set this only to add more (comma-separated, exact
# origins) -- e.g. a staging domain. Optional; leave unset for the default.
CORS_ALLOWED_ORIGINS=

# Error tracking/alerting (see src/lib/sentry.ts). Optional -- Sentry stays
# fully inert (no init, no network calls, no crash) until a real DSN is
# set. No DSN is provisioned yet.
SENTRY_DSN=

# Postgres — see db/schema.sql and README "Persistence" section.
# Defaults to this same value if unset; only /waitlist reads/writes it so far.
DATABASE_URL=postgres://bagged:bagged@localhost:5432/bagged

# --- Chain data providers ---
# HELIUS_API_KEY: required for real Solana data (src/providers/solana.ts).
# Without it, SolanaProvider degrades gracefully to a zeroed-out PnL/empty
# positions response rather than mock data or an error.
HELIUS_API_KEY=
# ALCHEMY_API_KEY: not wired up yet -- src/providers/evm.ts (BNB/Robinhood/
# Ethereum) still returns mock data; see NEXT_STEPS.md item 3.
ALCHEMY_API_KEY=
# NOTE: price.jup.ag/v6 (the original value here) is decommissioned and no
# longer resolves DNS. Jupiter now serves free/unauthenticated pricing from
# lite-api.jup.ag (current price endpoint: /price/v3, appended by
# src/providers/solana/jupiterClient.ts). See src/config.ts's comment.
JUPITER_API_BASE_URL=https://lite-api.jup.ag

# --- Webhook delivery worker (see src/worker/webhookWorker.ts, NEXT_STEPS.md
# item 6) --- all optional; defaults are in src/config.ts.
# How often (ms) the worker re-checks every registered wallet's PnL.
WEBHOOK_POLL_INTERVAL_MS=300000
# Delivery retries per triggered webhook, beyond the first attempt, with
# exponential backoff starting at WEBHOOK_DELIVERY_BACKOFF_MS.
WEBHOOK_DELIVERY_MAX_RETRIES=2
WEBHOOK_DELIVERY_BACKOFF_MS=500
