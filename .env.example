# Server
PORT=8080
LOG_LEVEL=info

# Auth (stubbed for now — see src/plugins/apiKey.ts)
API_KEY_SECRET=dev-secret-change-me
# Local dev only -- accepts the literal "dev" as a valid x-api-key so you
# don't need a real secret to hit the API locally. NEVER set this to
# "true" in Railway/production.
ALLOW_DEV_KEY=true

# Postgres (not wired up yet — see db/schema.sql and README "Persistence" section)
DATABASE_URL=postgres://bagged:bagged@localhost:5432/bagged

# --- Chain data providers ---
# HELIUS_API_KEY: required for real Solana data (src/providers/solana.ts).
# Without it, SolanaProvider degrades gracefully to a zeroed-out PnL/empty
# positions response rather than mock data or an error.
HELIUS_API_KEY=
# ALCHEMY_API_KEY: not wired up yet -- src/providers/evm.ts (BNB/Robinhood/
# Ethereum) still returns mock data; see NEXT_STEPS.md item 3.
ALCHEMY_API_KEY=
# NOTE: price.jup.ag/v6 (the original value here) is decommissioned and no
# longer resolves DNS. Jupiter now serves free/unauthenticated pricing from
# lite-api.jup.ag (current price endpoint: /price/v3, appended by
# src/providers/solana/jupiterClient.ts). See src/config.ts's comment.
JUPITER_API_BASE_URL=https://lite-api.jup.ag
